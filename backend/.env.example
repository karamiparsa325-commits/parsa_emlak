# Copy to .env and fill in your local values. Never commit .env to git.

PORT=3000

DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=emlakdb

# REQUIRED. Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Comma-separated cross-origin allowlist. Leave blank for same-origin-only.
# Example for prod:  FRONTEND_ORIGIN=https://parsaemlak.com,https://www.parsaemlak.com
FRONTEND_ORIGIN=

# Set to "production" on deploy. Enables Secure flag on the auth cookie.
NODE_ENV=development
